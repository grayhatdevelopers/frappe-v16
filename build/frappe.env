# Frappe release that build/apps.json is installed on, the frappe_docker commit whose
# Containerfile builds the image, and the frappe_docker images it builds in and runs on.
# frappe_docker publishes those images days after a Frappe release, so they are pinned on
# their own rather than looked up by FRAPPE_REF. Renovate keeps all four current.
FRAPPE_REF=v16.56.0
FRAPPE_DOCKER_REF=2e6c8573a2af9882df705ce4247a26eb69c4f597
FRAPPE_BUILD_IMAGE=frappe/build:v16.54.0
FRAPPE_BASE_IMAGE=frappe/base:v16.55.2
