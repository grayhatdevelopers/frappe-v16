# Combined Frappe v16 + ERPNext + HRMS + Payments image.
APP_IMAGE=ghcr.io/grayhatdevelopers/frappe-v16:v16-2026-07-15.1

# For the v16 upgrade use MariaDB 11.8. Keep MARIADB_AUTO_UPGRADE=1 while
# starting a copied/existing older MariaDB data volume with this image.
DB_IMAGE=mariadb:11.8
MARIADB_AUTO_UPGRADE=1

# Set ENABLE_DB=0 only when the database is external to this Compose project.
ENABLE_DB=1
DB_HOST=db
DB_PORT=3306
DB_ROOT_PASSWORD=replace-me

# Existing clone/production sites are detected automatically. ADMIN_PASSWORD
# is only required when deploying against a genuinely empty sites volume.
SITE_NAME=replace-with-site-name
ADMIN_PASSWORD=replace-me
SNAPSHOT=add-snapshot-tag

# Use the cloned volume names for rehearsal and the existing production volume
# names for production. Never point the clone at live production volumes.
DB_VOLUME_NAME=replace-with-db-volume
SITES_VOLUME_NAME=replace-with-sites-volume
LOGS_VOLUME_NAME=replace-with-logs-volume
REDIS_CACHE_VOLUME_NAME=replace-with-redis-cache-volume
REDIS_QUEUE_VOLUME_NAME=replace-with-redis-queue-volume

# Coolify proxy behavior.
PROXY_READ_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m
HTTPS=on
HTTP_X_FORWARDED_PROTO=https
HTTP_X_FORWARDED_SSL=on
HTTP_X_FORWARDED_PORT=443
FORCE_SSL=1

ENABLE_RESTORE=false
ENABLE_BACKUP=false
DOMAIN_NAME=


RESTIC_REPOSITORY=link
B2_KEY_ID=replace-me
B2_ACCOUNT_ID=replace-me
RESTIC_PASSWORD=replace-me