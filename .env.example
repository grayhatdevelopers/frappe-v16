# Use an immutable tag or digest. During the backup phase this must be the exact
# image currently running v15; during upgrade/runtime it must be the verified v16 image.
APP_IMAGE=ghcr.io/grayhatdevelopers/frappe-v16:v16-2026-07-15.1

# Use the exact existing database image in backup/rollback mode and 11.8 in
# v16 upgrade/restore/fresh/runtime mode. The deployed Compose declares MariaDB
# 10.6, but ENABLE_DB and the live container/digest must still be confirmed.
DB_IMAGE=mariadb:11.8
MARIADB_AUTO_UPGRADE=
ENABLE_DB=1
RUNTIME_REPLICAS=1

# This is the existing directory under sites/, not necessarily the public domain.
SITE_NAME=replace-with-live-site-name
BACKUP_SITE_NAME=
DB_HOST=db
DB_PORT=3306
DB_ROOT_PASSWORD=replace-me
ADMIN_PASSWORD=

# runtime | backup | upgrade | restore | rollback | fresh
DEPLOYMENT_MODE=runtime
OPERATION_ID=
MIGRATION_CONFIRMATION=
BACKUP_COPY_CONFIRMATION=

# This explicit Docker volume name must remain stable across the production and
# recovery Coolify Services.
BACKUP_VOLUME_NAME=grayhat-frappe-migration-backups

# For production, copy the exact resolved names from Coolify's deployable
# Compose. Rehearsal and rollback must use different fresh names.
DB_VOLUME_NAME=replace-with-live-db-volume
SITES_VOLUME_NAME=replace-with-live-sites-volume
LOGS_VOLUME_NAME=replace-with-live-logs-volume
REDIS_CACHE_VOLUME_NAME=replace-with-live-redis-cache-volume
REDIS_QUEUE_VOLUME_NAME=replace-with-live-redis-queue-volume

# Existing frontend behavior; adjust only if the current Coolify proxy contract differs.
PROXY_READ_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m
HTTPS=on
HTTP_X_FORWARDED_PROTO=https
HTTP_X_FORWARDED_SSL=on
HTTP_X_FORWARDED_PORT=443
FORCE_SSL=1
FRAPPE_SITE_NAME_HEADER=
