# The image to run: a release of this repository.
APP_IMAGE=ghcr.io/grayhatdevelopers/frappe-v16:v16-2026-07-16.12

# Set ENABLE_DB=0 only when the database is external to this Compose project.
ENABLE_DB=1
DB_HOST=db
DB_PORT=3306
DB_ROOT_PASSWORD=replace-me

# ADMIN_PASSWORD is only used when deploying against an empty sites volume.
SITE_NAME=replace-with-site-name
ADMIN_PASSWORD=replace-me

# Frontend (nginx). UPSTREAM_REAL_IP_ADDRESS is the proxy's network, whose
# X-Forwarded-For is trusted as the client IP.
UPSTREAM_REAL_IP_ADDRESS=10.0.0.0/8

# Backups (frappe_restic). 1 uploads backups to the repository; 0 keeps them local.
RESTIC_OFFSITE_BACKUP_ENABLED=0
RESTIC_REPOSITORY=s3:https://s3.<region>.backblazeb2.com/<bucket>/restic/<site>
RESTIC_PASSWORD=replace-me
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
# Optional Uptime Kuma push monitors.
RESTIC_BACKUP_UPTIME_KUMA_URL=
RESTIC_DEPLOYMENT_BACKUP_UPTIME_KUMA_URL=

# Every deploy backs up the site, then migrates it. To restore instead, set
# SITE_OPERATION=restore and a short snapshot ID (or latest), deploy, then set
# SITE_OPERATION back to migrate. Redeploying the same snapshot does nothing.
SITE_OPERATION=migrate
RESTIC_RESTORE_SNAPSHOT=
