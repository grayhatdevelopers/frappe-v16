{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended"],
	"semanticCommits": "enabled",
	"schedule": ["before 6am on monday"],
	"customManagers": [
		{
			"customType": "regex",
			"description": "Apps pinned to a release tag in the image",
			"managerFilePatterns": ["/^build/apps\\.json$/"],
			"matchStrings": ["\"url\": \"https://github\\.com/(?<depName>[^\"]+?)(?:\\.git)?\",\\s*\"branch\": \"(?<currentValue>v\\d[^\"]*)\""],
			"datasourceTemplate": "github-tags"
		},
		{
			"customType": "regex",
			"description": "Frappe release built into the image",
			"managerFilePatterns": ["/^build/frappe\\.env$/"],
			"matchStrings": ["FRAPPE_REF=(?<currentValue>v\\S+)"],
			"depNameTemplate": "frappe/frappe",
			"datasourceTemplate": "github-tags"
		},
		{
			"customType": "regex",
			"description": "frappe_docker commit whose Containerfile builds the image",
			"managerFilePatterns": ["/^build/frappe\\.env$/"],
			"matchStrings": ["FRAPPE_DOCKER_REF=(?<currentDigest>[0-9a-f]{40})"],
			"depNameTemplate": "frappe_docker",
			"packageNameTemplate": "https://github.com/frappe/frappe_docker",
			"currentValueTemplate": "main",
			"datasourceTemplate": "git-refs"
		}
	],
	"packageRules": [
		{
			"description": "A new Frappe, app or MariaDB major is a deliberate upgrade",
			"matchManagers": ["custom.regex", "docker-compose"],
			"matchUpdateTypes": ["major"],
			"enabled": false
		},
		{
			"matchPackageNames": ["frappe/frappe", "frappe/erpnext", "frappe/hrms", "frappe_docker"],
			"groupName": "Frappe"
		},
		{
			"matchManagers": ["github-actions"],
			"groupName": "GitHub Actions"
		}
	]
}
